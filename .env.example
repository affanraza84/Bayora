# ==============================================================================
# Bayora Shield - Environment Configuration Template
# DO NOT commit real secrets or production credentials to this file.
# Copy this file to .env before starting services locally:
#   cp .env.example .env
# ==============================================================================

# Project & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Control Plane API
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8000
JWT_SECRET_KEY=replace_with_a_secure_random_hex_key_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default: Local async SQLite for development and automated test suites
DATABASE_URL=sqlite+aiosqlite:///./bayora_shield.db
# Production / Docker Compose (internal control-net):
# DATABASE_URL=postgresql+asyncpg://bayora_admin:replace_with_secure_database_password@database:5432/bayora_shield

# Audit Service & Cryptographic Signatures
AUDIT_SERVICE_PORT=8001
ED25519_PRIVATE_KEY_PATH=/etc/bayora/keys/audit_ed25519.key
ED25519_PUBLIC_KEY_PATH=/etc/bayora/keys/audit_ed25519.pub

# Model Gateway & LLM Credentials (Mock or External)
MODEL_GATEWAY_PORT=8003
DEFAULT_MODEL_PROVIDER=mock
# Optional API Keys for upstream providers (used only in model-gateway container)
OPENAI_API_KEY=replace_with_optional_openai_api_key_if_using_external_llm
ANTHROPIC_API_KEY=replace_with_optional_anthropic_api_key_if_using_external_llm

# Worker Internal Service Ports
WORKER_RED_PORT=8004
WORKER_BLUE_PORT=8002
EVALUATOR_PORT=8005

# Dashboard Next.js Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
DASHBOARD_PORT=3000
